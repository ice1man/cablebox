// Lets the `cablebox` session user install OS updates, manage Wi-Fi and reboot
// without a password prompt (there is no keyboard to type one on a TV).
polkit.addRule(function (action, subject) {
    if (subject.user !== "cablebox") {
        return polkit.Result.NOT_HANDLED;
    }
    var allowed = [
        "org.freedesktop.packagekit.system-sources-refresh",
        "org.freedesktop.packagekit.system-update",
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions",
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.wifi.scan",
        "org.freedesktop.NetworkManager.enable-disable-wifi",
    ];
    if (allowed.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
    // Settings → System: "Remote access (SSH)" and "Exit to console". Only these units and
    // verbs; starting getty@tty1 makes systemd stop cablebox.service (Conflicts=).
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (unit === "ssh.service" && (verb === "start" || verb === "stop")) {
            return polkit.Result.YES;
        }
        if (unit === "getty@tty1.service" && verb === "start") {
            return polkit.Result.YES;
        }
    }
    return polkit.Result.NOT_HANDLED;
});
